{
  "name": "x-messenger-offline",
  "version": "1.0.4",
  "description": "Open-source offline encrypted QR courier",
  "main": "index.js",
  "bin": {
    "cipherlink": "bin/cipherlink"
  },
  "scripts": {
    "start": "npm run gui",
    "test": "node --test test/crypto.test.js test/offline.test.js test/ui-invariants.test.js",
    "build:web": "node scripts/build-web.js",
    "android:setup": "npm run android:sync && npx cap open android",
    "android:sync": "npm run build:web && npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "gui": "node bin/cipherlink gui",
    "linux:install": "bash scripts/install-linux-launcher.sh"
  },
  "license": "MIT",
  "author": "jackh0006",
  "keywords": [
    "offline",
    "encrypted",
    "qr",
    "messenger",
    "privacy"
  ],
  "type": "commonjs",
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "browserify": "^17.0.1"
  }
}
