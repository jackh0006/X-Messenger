{
  "$schema": "https://opencode.ai/config.json",
  // Copy to opencode.jsonc locally. Never commit real keys or tokens.
  // Pick values from your agent's model picker. Do not copy unverified names.
  "model": "YOUR_PROVIDER/YOUR_MODEL",
  "small_model": "YOUR_PROVIDER/YOUR_SMALL_MODEL",
  "permission": {
    "bash": {
      "git *": "allow",
      "flutter *": "allow",
      "*": "ask"
    }
  }
}
