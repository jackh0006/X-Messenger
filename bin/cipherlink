#!/usr/bin/env node
// SPDX-License-Identifier: MIT
const { spawn, execFileSync } = require('node:child_process');
const path = require('node:path');
const fs = require('node:fs');
const { webcrypto } = require('node:crypto');

global.crypto = global.crypto || webcrypto;
const root = path.resolve(__dirname, '..');
const { encryptText, decryptText, VERSION } = require(path.join(root, 'core.js'));
const APP_VERSION = VERSION || require(path.join(root, 'package.json')).version || '1.0.5';
const args = process.argv.slice(2);
const valueAfter = (flag) => {
  const index = args.indexOf(flag);
  return index === -1 ? undefined : args[index + 1];
};
const help = () => console.log(`X Messenger ${APP_VERSION} — offline encrypted courier
Seal on this device, hand over QR/text/.xmsg. No signal, no account, no server.

Use:
  cipherlink gui [--port 443] [--loopback|--lan|--vps --domain msg.example.com] [--regen-cert] [--cert-info]
  cipherlink setup [--yes]   (first-run wizard: port + mode + domain guide)
  cipherlink encrypt "your private message" --to "recipient name"
  cipherlink decrypt "XM1.…"
  cipherlink profile "name" "private note"
  cipherlink profiles
  cipherlink data export [backup.json]
  cipherlink data import backup.json
  cipherlink data delete --yes
  cipherlink version
  cipherlink help

Default GUI: https://127.0.0.1:443 loopback only, HTTPS, separate app window (zero egress).
If 443 is taken or needs privilege, you will be asked to choose another port.
--lan shares encrypted TLS on your LAN (IP/port/sizes observable).
--vps --domain msg.example.com serves your domain with a Let's Encrypt
cert (normal HTTPS; provider/DNS still see domain+IP+sizes, content stays XM1).
See docs/vps-domain-cloudflare.md + docs/vps-private-mode.md. Port 1024-65535
(443 needs capability: sudo setcap cap_net_bind_service=+ep $(readlink -f $(which node))).

The shared phrase is requested privately. --phrase is for non-interactive
automation only; it can be visible in shell history and process lists.
`);

function requestHiddenPhrase() {
  if (!process.stdin.isTTY) return Promise.reject(new Error('Use --phrase only when running non-interactively.'));
  return new Promise((resolve, reject) => {
    let value = '';
    const stdin = process.stdin;
    const previousRaw = stdin.isRaw;
    process.stdout.write('Shared phrase (input hidden): ');
    stdin.setRawMode(true);
    stdin.resume();
    const finish = () => {
      stdin.removeListener('data', onData);
      stdin.setRawMode(previousRaw || false);
      process.stdout.write('\n');
      resolve(value);
    };
    const onData = (chunk) => {
      for (const char of chunk.toString('utf8')) {
        if (char === '\u0003') { process.stdout.write('\n'); reject(new Error('Cancelled.')); return; }
        if (char === '\r' || char === '\n') { finish(); return; }
        if (char === '\u007f' || char === '\b') { value = value.slice(0, -1); continue; }
        value += char;
      }
    };
    stdin.on('data', onData);
  });
}

async function runCrypto() {
  const command = args[0];
  const suppliedPhrase = valueAfter('--phrase');
  const recipient = valueAfter('--to');
  const text = args[1];
  if (!text || (command !== 'encrypt' && command !== 'decrypt')) { console.error('Provide encrypt/decrypt and text. Run: cipherlink help'); process.exitCode = 2; return; }
  try {
    if (recipient) {
      const { file } = profileStore(); let list = [];
      try { list = JSON.parse(fs.readFileSync(file, 'utf8')); } catch {}
      if (!list.some(profile => profile.name.toLowerCase() === recipient.toLowerCase())) throw new Error(`No local recipient named "${recipient}". Add one with: cipherlink profile "${recipient}" "optional note"`);
      console.error(`Using local recipient label: ${recipient}`);
    }
    const phrase = suppliedPhrase || await requestHiddenPhrase();
    if (!phrase) throw new Error('A shared phrase is required.');
    if (suppliedPhrase) console.error('Warning: --phrase can be retained in shell history or visible to local users.');
    if (command === 'encrypt') console.log(await encryptText(text, phrase));
    else console.log(await decryptText(text, phrase));
  } catch (error) { console.error(`X Messenger: ${error.message}`); process.exitCode = 1; }
}

function profileStore() {
  const dir = path.join(process.env.XDG_DATA_HOME || path.join(process.env.HOME || '.', '.local', 'share'), 'x-messenger');
  return { dir, file: path.join(dir, 'recipients.json') };
}
function profiles() {
  const command = args[0]; const { dir, file } = profileStore();
  if (command === 'profile') {
    const [rawName, rawNote = ''] = args.slice(1); if (!rawName) { console.error('Provide a local profile name.'); process.exitCode = 2; return; }
    const name = String(rawName).slice(0, 40).trim(); const note = String(rawNote).slice(0, 120).trim();
    if (!name) { console.error('Provide a local profile name.'); process.exitCode = 2; return; }
    fs.mkdirSync(dir, { recursive: true, mode: 0o700 }); let list = []; try { const st = fs.statSync(file); if (st.size > 200 * 1024) throw new Error('Local store too large.'); list = JSON.parse(fs.readFileSync(file, 'utf8')); if (!Array.isArray(list)) list = []; } catch (e) { if (e.message === 'Local store too large.') throw e; }
    if (list.length >= 100) { console.error('Too many local recipients (max 100).'); process.exitCode = 2; return; }
    if (list.some(p => String(p.name).toLowerCase() === name.toLowerCase())) { console.error(`Local recipient "${name}" already exists.`); process.exitCode = 2; return; }
    list.push({ name, note, createdAt: new Date().toISOString() }); fs.writeFileSync(file, JSON.stringify(list, null, 2), { mode: 0o600 }); console.log(`Saved local recipient: ${name}`); return;
  }
  try { const list = JSON.parse(fs.readFileSync(file, 'utf8')); if (!list.length) console.log('No local recipients saved.'); else list.forEach((p, i) => console.log(`${i + 1}. ${p.name}${p.note ? ` — ${p.note}` : ''}`)); } catch { console.log('No local recipients saved.'); }
}

function dataCommand() {
  const action = args[1]; const { dir, file } = profileStore();
  if (action === 'export') {
    const destination = path.resolve(args[2] || 'x-messenger-cli-backup.json'); let recipients = [];
    try { recipients = JSON.parse(fs.readFileSync(file, 'utf8')); } catch {}
    fs.writeFileSync(destination, JSON.stringify({ format: 'x-messenger-cli-backup-v1', exportedAt: new Date().toISOString(), recipients }, null, 2), { mode: 0o600 }); console.log(`Exported local CLI data to: ${destination}`); return;
  }
  if (action === 'import') {
    const source = args[2]; if (!source) { console.error('Provide a backup file to import.'); process.exitCode = 2; return; }
    try { const st = fs.statSync(path.resolve(source)); if (st.size > 1024 * 1024) throw new Error('Backup too large (max 1MB).'); const backup = JSON.parse(fs.readFileSync(path.resolve(source), 'utf8')); if (backup.format !== 'x-messenger-cli-backup-v1' || !Array.isArray(backup.recipients)) throw new Error('Invalid X Messenger CLI backup.'); if (backup.recipients.length > 100) throw new Error('Backup has too many recipients (max 100).'); const recipients = backup.recipients.map(item => ({ name: String(item.name || '').slice(0, 40).trim(), note: String(item.note || '').slice(0, 120).trim(), createdAt: String(item.createdAt || new Date().toISOString()) })).filter(item => item.name); fs.mkdirSync(dir, { recursive: true, mode: 0o700 }); fs.writeFileSync(file, JSON.stringify(recipients, null, 2), { mode: 0o600 }); console.log(`Restored ${recipients.length} local recipient(s).`); } catch (error) { console.error(`X Messenger: ${error.message}`); process.exitCode = 1; } return;
  }
  if (action === 'delete') {
    if (!args.includes('--yes')) { console.error('Refusing to delete local CLI data without --yes.'); process.exitCode = 2; return; }
    try { const st = fs.statSync(file); const fd = fs.openSync(file, 'r+'); try { fs.writeSync(fd, Buffer.alloc(Math.min(st.size, 65536), 0), 0, Math.min(st.size, 65536), 0); } finally { fs.closeSync(fd); } } catch (error) { if (error.code !== 'ENOENT') throw error; }
    try { fs.unlinkSync(file); } catch (error) { if (error.code !== 'ENOENT') throw error; } console.log('Deleted local CLI recipient data (overwritten once before removal).'); return;
  }
  console.error('Use: cipherlink data export [backup.json] | import backup.json | delete --yes'); process.exitCode = 2;
}

function lanIp() {
  const { networkInterfaces } = require('node:os');
  for (const list of Object.values(networkInterfaces())) {
    for (const nic of list || []) {
      if (nic.family === 'IPv4' && !nic.internal) return nic.address;
    }
  }
  return '127.0.0.1';
}
function guiPrefsFile() {
  const base = path.join(process.env.XDG_DATA_HOME || path.join(process.env.HOME || '.', '.local', 'share'), 'x-messenger');
  return path.join(base, 'gui.json');
}
function readGuiPrefs() {
  try { return JSON.parse(fs.readFileSync(guiPrefsFile(), 'utf8')); } catch { return {}; }
}
function writeGuiPrefs(p) {
  const f = guiPrefsFile();
  fs.mkdirSync(path.dirname(f), { recursive: true, mode: 0o700 });
  fs.writeFileSync(f, JSON.stringify(p, null, 2), { mode: 0o600 });
}
function makeCert(key, cert, sanIp) {
  const san = sanIp && sanIp !== '127.0.0.1' ? `DNS:localhost,IP:127.0.0.1,IP:${sanIp}` : 'DNS:localhost,IP:127.0.0.1';
  execFileSync('openssl', ['req', '-x509', '-newkey', 'rsa:2048', '-sha256', '-nodes', '-keyout', key, '-out', cert, '-days', '825', '-subj', '/CN=localhost', '-addext', `subjectAltName=${san}`], { stdio: 'ignore' });
  fs.chmodSync(key, 0o600); fs.chmodSync(cert, 0o600);
}
function certInfo(key, cert) {
  const { X509Certificate } = require('node:crypto');
  try {
    const c = new X509Certificate(fs.readFileSync(cert));
    console.log(`Cert: ${cert}\nSHA256: ${c.fingerprint256}\nValid: ${c.validFrom} → ${c.validTo}\nSAN: ${c.subjectAltName}\nKey: ${key}`);
  } catch (e) { console.error(`No TLS cert yet: ${e.message}`); process.exitCode = 1; }
}
function validDomain(d) {
  return typeof d === 'string' && /^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?\.[a-z]{2,}$/i.test(d.trim()) && d.trim().length <= 253;
}
function vpsCertPaths(dataDir, domain) {
  return { key: path.join(dataDir, `vps-${domain}-privkey.pem`), cert: path.join(dataDir, `vps-${domain}-fullchain.pem`) };
}
function runSetup() {
  const rl = require('node:readline').createInterface({ input: process.stdin, output: process.stdout });
  const nonInteractive = args.includes('--yes');
  const ask = (q, def) => new Promise((res) => {
    if (nonInteractive) return res(def);
    rl.question(`${q} [${def}]: `, (a) => res(a.trim() || def));
  });
  (async () => {
    console.log('X Messenger setup — port + mode + optional domain.');
    console.log('1) This device (loopback, zero egress)  2) LAN (observable TLS)  3) My VPS domain (normal HTTPS, see docs/vps-private-mode.md)');
    const portA = await ask('Port (1024-65535; default 443 HTTPS, fallback 8443)', '443');
    const modeA = await ask('Mode (1=this device, 2=lan, 3=vps)', '1');
    let prefs = readGuiPrefs();
    const p = Number.parseInt(portA, 10);
    if (!Number.isInteger(p) || p < 1 || p > 65535) { console.error('Port must be 1-65535 (use 1024+ unless 443 with capability).'); process.exitCode = 2; rl.close(); return; }
    if (p < 1024) console.warn('Privileged port: needs setcap/capability or a 443→8443 proxy. See docs/vps-domain-cloudflare.md.');
    prefs.port = p;
    if (modeA === '3') {
      const d = (await ask('Domain (e.g. msg.example.com)', prefs.domain || '')).toLowerCase();
      if (!validDomain(d)) { console.error('Invalid domain. Use a public FQDN like msg.example.com.'); process.exitCode = 2; rl.close(); return; }
      prefs.bind = 'vps'; prefs.domain = d;
      console.log('VPS guide: point A/AAAA msg→server IP (Cloudflare grey-cloud/DNS-only for E2E), then:');
      console.log(`  sudo certbot certonly --standalone -d ${d}   # or --nginx / --dns-cloudflare`);
      console.log(`  sudo install -m 600 /etc/letsencrypt/live/${d}/privkey.pem ~/.local/share/x-messenger/tls/vps-${d}-privkey.pem`);
      console.log(`  sudo install -m 644 /etc/letsencrypt/live/${d}/fullchain.pem ~/.local/share/x-messenger/tls/vps-${d}-fullchain.pem`);
      console.log('Provider/DNS/network still see domain+IP+sizes; XM1 content stays end-to-end. Never proxy orange-cloud if you want E2E.');
    } else if (modeA === '2') {
      prefs.bind = 'lan';
      console.log('LAN mode: encrypted TLS but observable on your network. Compare cert fingerprint in person.');
    } else { prefs.bind = 'loopback'; delete prefs.domain; }
    writeGuiPrefs(prefs);
    console.log(`Saved: bind=${prefs.bind} port=${prefs.port}${prefs.domain ? ` domain=${prefs.domain}` : ''}. Run: x-messenger gui`);
    rl.close();
  })();
}
function isPortFree(port, host) {
  const net = require('node:net');
  return new Promise((resolve) => {
    const s = net.createServer();
    s.once('error', (e) => resolve({ ok: false, code: e.code || 'EADDRINUSE' }));
    s.once('listening', () => s.close(() => resolve({ ok: true })));
    try { s.listen(port, host); } catch (e) { resolve({ ok: false, code: e.code || 'EADDRINUSE' }); }
  });
}
function promptPort(question, def) {
  const rl = require('node:readline').createInterface({ input: process.stdin, output: process.stdout });
  return new Promise((res) => rl.question(`${question} [${def}]: `, (a) => { rl.close(); res((a || '').trim() || String(def)); }));
}
function openSeparateWindow(endpoint, certPath) {
  // Separate app window, never a browser tab and never the file protocol.
  // Uses Chrome --app with an isolated profile so tabs, extensions and
  // browsing history are not shared with the user's normal browser.
  const base = path.join(process.env.XDG_DATA_HOME || path.join(process.env.HOME || '.', '.local', 'share'), 'x-messenger');
  const profile = path.join(base, 'chrome-app-profile');
  try { fs.mkdirSync(profile, { recursive: true, mode: 0o700 }); } catch {}
  let fp = '';
  try { fp = new (require('node:crypto').X509Certificate)(fs.readFileSync(certPath)).fingerprint256; } catch {}
  const candidates = [];
  if (process.env.BROWSER) candidates.push(process.env.BROWSER);
  candidates.push('google-chrome', 'chromium', 'chromium-browser');
  const tryNext = (i) => {
    if (i >= candidates.length) {
      console.log(`X Messenger ready at ${endpoint} [separate window unavailable].`);
      console.log(`Open it in a Chromium --app window: chromium --app=${endpoint}`);
      if (fp) console.log(`Cert SHA256 (compare on first run): ${fp}`);
      return;
    }
    const browser = candidates[i];
    const child = spawn(browser, [`--app=${endpoint}`, `--user-data-dir=${profile}`, '--no-first-run', '--no-default-browser-check'], { detached: true, stdio: 'ignore' });
    child.on('error', () => tryNext(i + 1));
    child.unref();
  };
  tryNext(0);
}
async function openGui() {
  // Debian installs immutable, prebuilt files in /usr/lib. Development builds
  // the offline bundle first; the installed app serves that bundle locally.
  const installedBundle = root.startsWith('/usr/lib/') && fs.existsSync(path.join(root, 'www', 'index.html'));
  if (!installedBundle) execFileSync(process.execPath, ['scripts/build-web.js'], { cwd: root, stdio: 'inherit' });
  const wantPort = valueAfter('--port');
  const wantLan = args.includes('--lan');
  const wantLoopback = args.includes('--loopback');
  const wantVps = args.includes('--vps');
  const wantDomain = valueAfter('--domain');
  const wantRegen = args.includes('--regen-cert');
  if (!fs.existsSync(guiPrefsFile()) && wantPort === undefined && !wantLan && !wantLoopback && !wantVps && !args.includes('--cert-info')) {
    console.log('First run: no gui.json yet. Starting with safe defaults (loopback 443, HTTPS, separate window).');
  }
  let prefs = readGuiPrefs();
  if (wantPort !== undefined) {
    const p = Number.parseInt(wantPort, 10);
    if (!Number.isInteger(p) || p < 1 || p > 65535) { console.error('Port must be 1-65535 (1024+ recommended; 443 needs capability).'); process.exitCode = 2; return; }
    if (p < 1024) console.warn('Privileged port: needs setcap/capability or proxy. See docs/vps-domain-cloudflare.md.');
    prefs.port = p;
  }
  if (wantLan) prefs.bind = 'lan';
  if (wantLoopback) prefs.bind = 'loopback';
  if (wantVps) prefs.bind = 'vps';
  if (wantDomain !== undefined) {
    const d = String(wantDomain).toLowerCase();
    if (!validDomain(d)) { console.error('Invalid --domain. Use a public FQDN like msg.example.com.'); process.exitCode = 2; return; }
    prefs.domain = d; prefs.bind = 'vps';
  }
  if (wantPort !== undefined || wantLan || wantLoopback || wantVps || wantDomain !== undefined) writeGuiPrefs(prefs);
  if (prefs.bind === 'vps' && !validDomain(prefs.domain)) { console.error('VPS mode needs --domain msg.example.com. Run: x-messenger setup'); process.exitCode = 2; return; }
  const bind = prefs.bind === 'vps' ? 'vps' : prefs.bind === 'lan' ? 'lan' : 'loopback';
  let port = prefs.port || 443;
  const base = path.join(process.env.XDG_DATA_HOME || path.join(process.env.HOME || '.', '.local', 'share'), 'x-messenger');
  const dataDir = path.join(base, 'tls');
  fs.mkdirSync(dataDir, { recursive: true, mode: 0o700 });
  const ip = lanIp();
  // Default 443. If taken or privileged, ask for another port and use it.
  const hostProbe = bind === 'loopback' ? '127.0.0.1' : '0.0.0.0';
  let probe = await isPortFree(port, bind === 'loopback' ? '127.0.0.1' : undefined);
  if (!probe.ok && process.stdin.isTTY && wantPort === undefined) {
    console.warn(`Port ${port} unavailable (${probe.code}; 443 needs: sudo setcap cap_net_bind_service=+ep $(readlink -f $(which node))).`);
    const answer = await promptPort('Choose another port (1024-65535)', 8443);
    const p = Number.parseInt(answer, 10);
    if (!Number.isInteger(p) || p < 1024 || p > 65535) { console.error('Port must be 1024-65535.'); process.exitCode = 2; return; }
    port = p;
    prefs.port = p;
    writeGuiPrefs(prefs);
    probe = await isPortFree(port, bind === 'loopback' ? '127.0.0.1' : undefined);
    if (!probe.ok) { console.error(`Port ${port} also unavailable (${probe.code}). Free it and retry.`); process.exitCode = 1; return; }
  } else if (!probe.ok) {
    console.error(`Port ${port} unavailable (${probe.code}). Retry with: x-messenger gui --port 8443`);
    if (port < 1024) console.error('Privileged port: sudo setcap cap_net_bind_service=+ep $(readlink -f $(which node))');
    process.exitCode = 1;
    return;
  }
  let key, cert;
  if (bind === 'vps') {
    ({ key, cert } = vpsCertPaths(dataDir, prefs.domain));
    if (wantRegen || !fs.existsSync(key) || !fs.existsSync(cert)) {
      console.error(`Missing Let's Encrypt cert for ${prefs.domain}. Install it first (see setup guide), expected:\n  ${key}\n  ${cert}`);
      if (!wantRegen) { process.exitCode = 2; return; }
    }
  } else {
    key = path.join(dataDir, 'localhost-key.pem');
    cert = path.join(dataDir, 'localhost-cert.pem');
    if (wantRegen || !fs.existsSync(key) || !fs.existsSync(cert)) {
      makeCert(key, cert, bind === 'lan' ? ip : undefined);
      console.log(`TLS cert ${wantRegen ? 'regenerated' : 'created'} (SAN includes ${bind === 'lan' ? ip : '127.0.0.1'}).`);
    }
  }
  if (args.includes('--cert-info')) { certInfo(key, cert); return; }
  const endpointFile = path.join(dataDir, `endpoint-${process.pid}.txt`);
  try { fs.unlinkSync(endpointFile); } catch {}
  const gui = spawn(process.execPath, [path.join(root, 'server.js')], { cwd: root, detached: true, stdio: 'ignore', env: { ...process.env, X_MESSENGER_TLS_KEY: key, X_MESSENGER_TLS_CERT: cert, X_MESSENGER_ENDPOINT_FILE: endpointFile, X_MESSENGER_PORT: String(port), X_MESSENGER_BIND: bind, X_MESSENGER_LAN_IP: ip, X_MESSENGER_DOMAIN: prefs.domain || '' } });
  gui.unref();
  const started = Date.now();
  const timer = setInterval(() => {
    if (fs.existsSync(endpointFile)) {
      clearInterval(timer); const endpoint = fs.readFileSync(endpointFile, 'utf8').trim();
      try { fs.unlinkSync(endpointFile); } catch {}
      if (process.env.X_MESSENGER_NO_BROWSER === '1') { console.log(`X Messenger ready at ${endpoint} [bind=${bind}].`); return; }
      openSeparateWindow(endpoint, cert);
      if (bind === 'vps') console.log(`X Messenger opened at ${endpoint} in a separate window. VPS: normal HTTPS, but provider/DNS see domain+IP+sizes; XM1 content stays end-to-end (grey-cloud for E2E).`);
      else if (bind === 'lan') console.log(`X Messenger opened at ${endpoint} in a separate window. LAN mode: encrypted TLS, but routers/DPI see LAN IP/port/sizes. Compare cert fingerprint in person.`);
      else console.log(`X Messenger opened at ${endpoint} in a separate window. It is bound only to this device (loopback, zero egress).`);
    } else if (Date.now() - started > 5000) { clearInterval(timer); console.error('X Messenger could not start its local app server.'); }
  }, 80);
}

if (!args.length || args[0] === 'help' || args[0] === '--help') help();
else if (args[0] === 'version' || args[0] === '--version' || args[0] === '-V') console.log(APP_VERSION);
else if (args[0] === 'setup') runSetup();
else if (args[0] === 'gui' || args[0] === 'gu') openGui();
else if (args[0] === 'profile' || args[0] === 'profiles') profiles();
else if (args[0] === 'data') dataCommand();
else if (args[0] === 'encrypt' || args[0] === 'decrypt') runCrypto();
else { console.error(`Unknown command "${args[0]}". Use: x-messenger gui`); help(); process.exitCode = 2; }
